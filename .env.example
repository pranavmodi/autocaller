# Attorney cold-call autocaller — .env template.
# Copy to .env, then `bin/possibleos config init` can walk you through most of it.

# ---- Backend ----
BACKEND_PORT=8000
DATABASE_URL=postgresql://autocaller:password@localhost:5432/autocaller

# ---- Voice provider selection ----
# Default provider for new calls. The DB setting (system_settings.voice_provider)
# and per-call override (--voice flag / API body) take precedence over this env.
VOICE_PROVIDER=openai

# ---- OpenAI Realtime (required if VOICE_PROVIDER=openai) ----
OPENAI_API_KEY=sk-your-key-here
# Optional overrides
# OPENAI_REALTIME_MODEL=gpt-realtime-2025-08-28
# OPENAI_VOICE=alloy
# OPENAI_VAD_THRESHOLD=0.85
# OPENAI_VAD_PREFIX_MS=300
# OPENAI_VAD_SILENCE_MS=700

# ---- TypeSafe System One (Jev) ----
TYPESAFE_API_KEY=
# JOB_AGENT_TYPESAFE_MODEL=jev-latest
# JOB_AGENT_CLASSIFICATION_TIMEOUT_S=120
# JOB_CONTRACT_TYPESAFE_MODEL=jev-latest
# JOB_CONTRACT_CLASSIFICATION_TIMEOUT_S=120
# JOB_AGENT_IDENTITY_TIMEOUT_S=30

# ---- Gemini Live (required if VOICE_PROVIDER=gemini) ----
# Google's latest real-time voice model on the generativelanguage v1beta API
# is Gemini 3.1 Flash Live Preview. (Previous: gemini-2.5-flash-native-audio-*.)
GEMINI_API_KEY=
# Optional overrides
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_VOICE=Aoede

# ---- Twilio (required for real outbound calls) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15551234567
# Must be set to "true" before any real call goes out — safety gate.
ALLOW_TWILIO_CALLS=false
# Must be set to "true" before the voicemail / no-reach follow-up emailer
# actually sends. Loop ticks no-op when false. Pair with SMTP_* or Resend.
ALLOW_VOICEMAIL_EMAIL=false
# Public HTTPS URL where Twilio can reach your backend for TwiML + media-stream WS.
PUBLIC_BASE_URL=https://autocaller.example.com

# ---- Cal.com (required for demo booking) ----
CALCOM_API_KEY=cal_...
CALCOM_EVENT_TYPE_ID=123456
CALCOM_DEFAULT_TIMEZONE=America/New_York
# Optional
# CALCOM_API_BASE=https://api.cal.com/v2
# CALCOM_API_VERSION=2024-08-13

# ---- Sales rep context (injected into the AI prompt) ----
SALES_REP_NAME=Alex
SALES_REP_COMPANY=Possible Minds
SALES_REP_EMAIL=alex@possibleminds.com
PRODUCT_CONTEXT="We've shipped intake bots, demand letter tools, and lien-processing automations for 8+ PI firms — average 11 hrs/week saved."

# ---- Calling hours (lead's local timezone) ----
# Not consumed from env directly; configured in DB via `possibleos config` or settings API.
# BUSINESS_HOURS_START=09:00
# BUSINESS_HOURS_END=17:00
# BUSINESS_HOURS_DAYS=0,1,2,3,4

# ---- Optional: daily Slack report ----
# SLACK_DAILY_REPORT_ENABLED=false
# SLACK_DAILY_REPORT_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_DAILY_REPORT_HOUR=7
# SLACK_DAILY_REPORT_TIMEZONE=America/Los_Angeles

# ---- Optional: follow-up email SMTP ----
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=...
# SMTP_FROM_EMAIL=noreply@acme.ai
# EMAIL_ALLOWED_FROM_ADDRESSES=noreply@acme.ai,pranav@example.com
# THREAD_REPLY_FROM_EMAIL=noreply@acme.ai

# ---- Optional: dynamic lead email composer ----
# LEAD_EMAIL_COMPOSER_MODEL=openclaw
# LEAD_EMAIL_COMPOSER_SKILL_PATH=/home/pranav/possibleos/app/skills/possible-minds-lead-email-composer/SKILL.md
# LEAD_GEN_BLOG_LINKS=https://getpossibleminds.com/blog/example
# Off by default. When true, a successful daily first-touch lead-gen send seeds
# a 3-step follow-up sequence at days 0, 3, and 7; follow-up sends still require
# operator approval and ALLOW_SEQUENCE_SEND=true.
# SEQUENCES_ENABLED=0
# SEQUENCE_STEPS=3
# SEQUENCE_CADENCE_DAYS=0,3,7

# ---- Dedicated Codex app-server gateway (independent of OpenClaw) ----
# The companion systemd unit listens only on localhost. Any Possible OS agent
# can use /api/codex-gateway or `bin/possibleos codex-gateway ...`.
# CODEX_APP_SERVER_URL=ws://127.0.0.1:4510
# CODEX_APP_SERVER_MODEL=gpt-5.6-luna
# CODEX_APP_SERVER_EFFORT=low
# CODEX_APP_SERVER_TIMEOUT_S=300
# CODEX_APP_SERVER_CWD=/home/pranav/possibleos
# CODEX_APP_SERVER_MAX_MESSAGE_BYTES=16777216
# LEAD_FINDER_CODEX_EFFORT=low
# LEAD_FINDER_CODEX_WEB_EFFORT=low
# LEAD_FINDER_CODEX_TIMEOUT_S=300
# LEAD_FINDER_CODEX_SCHEMA_REPAIR_RETRIES=1

# ---- Optional: AI Audit freeware ----
# Standalone AI Audit public base. possibleos redirects tracked audit clicks here.
AIAUDIT_PUBLIC_URL=https://audit.example.com
# Legacy fallback public base for short tracked audit links.
AIAUDIT_LINK_BASE_URL=https://audit.example.com
# Public bases for destination-specific short links in lead-gen email.
AUDIT_LINK_BASE_URL=https://audit.example.com
CONSULT_LINK_BASE_URL=https://www.example.com
INTAKE_LINK_BASE_URL=https://intake.example.com
SOLUTION_LINK_BASE_URL=https://www.example.com

# ---- Optional: AI Search Visibility freeware ----
# Standalone AI Visibility report public base. possibleos redirects tracked
# report clicks to AIVIS_REPORT_BASE_URL/r/<scan_id>.
AIVIS_REPORT_BASE_URL=https://visibility.example.com
# Public base for short tracked AI Visibility report links. Falls back to
# OUTREACH_PUBLIC_BASE_URL when unset.
VISIBILITY_LINK_BASE_URL=https://possible.example.com

# ---- Optional: verbose logs ----
# VERBOSE_LOGGING=true

# ---- UI / API auth (optional; set both to enable password login) ----
# If both are set, the Next.js dashboard + /api/* + /ws/* require a
# session cookie obtained from POST /api/auth/login {password: ...}.
# Twilio webhooks and loopback CLI traffic are always exempt so
# server-to-server paths keep working.
# AUTH_PASSWORD=
# AUTH_SESSION_SECRET=      # generate with: openssl rand -hex 32
# AUTH_COOKIE_SECURE=true   # set false in local http dev

# ---- Native PI-firm directory (pulled from emailtag's pif-info API) ----
# possibleos can pull the firm directory directly from emailtag into Postgres
# (table pif_directory_firms) instead of reading the mission.db cache, whose
# Mission Control sync stopped in March 2026 (stale at ~1,711 vs ~3,500 live).
# Off by default. When "1", lead-gen domain matching reads the native directory
# and the 01:00 Asia/Kolkata nightly pipeline refreshes it; mission.db stays
# the fallback when off.
# Warm the table first with `bin/possibleos pif sync` (safe regardless of flag),
# then flip this to cut over.
# PIF_DIRECTORY_NATIVE=0
# Fixed nightly producers: directory -> autoresponses -> contacts -> Front ->
# due research. Restart waits for the next 01:00 IST (19:30 UTC) slot, no catchup.
# Inspect the LIVE server using `bin/possibleos pif nightly-status`.
# POSSIBLEOS_NIGHTLY_SYNC_ENABLED=true
# POSSIBLEOS_NIGHTLY_STAGE_TIMEOUT_SECONDS=1800
# FRONT_SYNC_ENABLED=true
# FRONT_SYNC_MAX_CALLS=300
# Native OpenClaw WebSocket RPC. Interactive work and background research use
# separate one-at-a-time lanes so bulk queues cannot block Job Agent actions.
# OPENCLAW_GATEWAY_RPC_URL=ws://127.0.0.1:18789
# OPENCLAW_RPC_INTERACTIVE_LANE=possibleos-interactive
# OPENCLAW_RPC_BATCH_LANE=possibleos-batch
# OPENCLAW_RPC_CONNECT_TIMEOUT_S=30
# Optional compatibility override. Default follows the per-call run timeout
# because some gateway builds return the agent response only at completion.
# OPENCLAW_RPC_ACCEPT_TIMEOUT_S=435
# OPENCLAW_GATEWAY_TIMEOUT_S=180
# OPENCLAW_GATEWAY_RETRIES=3
# Local firm profile, review, job-posting, and sitemap maintenance after sync.
# Successful checks default to 30-day freshness. Tier A/B firms refresh the
# fast-moving signal modules every 7 days. The daily limit is applied per kind.
# PIF_RESEARCH_MAINTENANCE_ENABLED=true
# PIF_RESEARCH_MAINTENANCE_REFRESH_DAYS=30
# PIF_FIRM_PROFILE_REFRESH_DAYS=30
# PIF_JOB_POSTINGS_REFRESH_DAYS=30
# PIF_SITEMAP_REFRESH_DAYS=30
# PIF_REVIEWS_REFRESH_DAYS=30
# PIF_HIGH_ICP_SIGNAL_REFRESH_DAYS=7
# PIF_RESEARCH_MAINTENANCE_RETRY_DAYS=3
# PIF_RESEARCH_MAINTENANCE_DAILY_LIMIT=175
# PIF_RESEARCH_MAINTENANCE_QUEUE_CONCURRENCY=8
# Legacy FRONT_SYNC_INTERVAL_SECONDS, PIF_RESEARCH_MAINTENANCE_INTERVAL_SECONDS,
# and PIF_RESEARCH_MAINTENANCE_STARTUP_DELAY_SECONDS no longer control scheduling.
# Semantic GTM trigger validation. Related candidates are batched; unchanged
# snapshots and snapshots without candidates make no gateway call.
# PIF_TRIGGER_LLM_PROVIDER=openai  # openai (stateless structured output) or openclaw
# PIF_TRIGGER_OPENAI_API_KEY=      # falls back to LEAD_FINDER_OPENAI_API_KEY, then OPENAI_API_KEY
# PIF_TRIGGER_OPENAI_MODEL=gpt-5.6-luna
# PIF_TRIGGER_OPENCLAW_MODEL=openclaw/main
# PIF_TRIGGER_LLM_BATCH_SIZE=24
# PIF_TRIGGER_LLM_BATCH_CHARS=24000
# PIF_TRIGGER_LLM_MAX_TOKENS=5000
# PIF_TRIGGER_LLM_RETRIES=3
# PIF_TRIGGER_OPENAI_TIMEOUT_S=180
# PIFSTATS_BASE_URL=https://emailprocessing.mediflow360.com/api/v1/pif-info
# PIFSTATS_AUTH_TOKEN=      # only if the pif-info API requires auth (reads are open today)

# Employer website application worker; starts only after explicit per-job authorization.
JOB_BROWSER_MAX_SESSIONS=3
JOB_BROWSER_STEP_BUDGET=60

# Shared private socket for backend and independent browser owner. Default:
# JOB_BROWSER_SOCKET=/home/pranav/possibleos/var/job-browser/broker.sock
